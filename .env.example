# Copy to .env and fill in values. Never commit real secrets.

# --- Public (client-readable, shipped to the browser) ---
# Backend project ref / URL / publishable (anon) key
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Browser-side Google Maps key used by the /map page
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
# Google Maps usage tracking id
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# --- Server-only (never exposed to the browser) ---
# Same backend project, read during SSR / server functions
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role key: bypasses RLS, server-side admin use only
SUPABASE_SERVICE_ROLE_KEY=
# Server-side Google Maps key (geocoding server function)
GOOGLE_MAPS_API_KEY=
# setlist.fm API key used to fetch setlists
SETLISTFM_API_KEY=
# Spotify OAuth app credentials (login + playlist creation)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Lovable AI Gateway key
LOVABLE_API_KEY=
